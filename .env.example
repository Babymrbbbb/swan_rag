# ===== 鉴权 =====
RAG_API_KEY=dev-secret-key

# ===== LLM 供应商 =====
# mock = 离线模拟（默认，无需外网）；real = 调用真实 OpenAI 兼容网关
RAG_LLM_PROVIDER=mock
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_MAX_TOKENS=512

# ===== 向量化供应商 =====
# mock = 哈希向量（离线）；real = 调用 OpenAI 兼容 embeddings
RAG_EMBEDDER_PROVIDER=mock
RAG_EMBEDDER_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDER_API_KEY=
RAG_EMBEDDER_MODEL=text-embedding-3-small
RAG_EMBED_DIM=256

# ===== RAG 参数 =====
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# ===== 数据库 =====
RAG_RAG_DB_FILE=swan_rag.db
